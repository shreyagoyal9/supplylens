# ─────────────────────────────────────────────────────────────────
# SupplyLens — Backend environment variables
# Copy this file to .env and fill in real values before starting.
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Supabase (free PostgreSQL) ────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ── Python ML service ─────────────────────────────────────────────
# Local dev:  http://localhost:5001
# Render:     https://supplylens-ml.onrender.com
ML_SERVICE_URL=http://localhost:5001

# ── CORS ──────────────────────────────────────────────────────────
# Local dev:  http://localhost:5173
# Render:     https://supplylens-frontend.onrender.com
FRONTEND_URL=http://localhost:5173

# ── IoT Simulator ────────────────────────────────────────────────
# How often a new sensor reading is generated (milliseconds)
SIMULATOR_INTERVAL_MS=5000

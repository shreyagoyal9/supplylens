# Copy this to .env and fill in your values

# Supabase (free tier) — get from supabase.com dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Python ML service URL (local: http://localhost:5000, Railway: https://your-ml.railway.app)
ML_SERVICE_URL=http://localhost:5000

# Server config
PORT=3001
NODE_ENV=development

# How often the IoT simulator fires (milliseconds)
SIMULATOR_INTERVAL_MS=5000

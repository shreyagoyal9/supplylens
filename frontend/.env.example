# ─────────────────────────────────────────────────────────────────
# SupplyLens — Frontend environment variables
# Copy this file to .env.local and fill in real values.
# VITE_ prefix is required — Vite only exposes these to the browser.
# ─────────────────────────────────────────────────────────────────

# ── API base URL ──────────────────────────────────────────────────
# Local dev: leave blank — Vite proxy in vite.config.js handles it
# Render:    https://supplylens-backend.onrender.com/api
VITE_API_URL=

# ── WebSocket URL ─────────────────────────────────────────────────
# Local dev: ws://localhost:3001
# Render:    wss://supplylens-backend.onrender.com  (wss:// not ws://)
VITE_WS_URL=ws://localhost:3001
